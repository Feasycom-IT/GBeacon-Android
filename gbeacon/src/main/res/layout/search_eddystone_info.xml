<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/BeaconInfo_TV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eddystone " />

            <TextView
                android:id="@+id/tv_frame_type"
                style="@style/BeaconInfo_TV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="unknow unknow" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_eddystone_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tx power at 0m: " />

                <TextView
                    android:id="@+id/tv_eddystone_url_rssi"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URL: " />

                <TextView
                    android:id="@+id/tv_eddystone_url"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:textColorLink="@color/text_color_blue" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_eddystone_uid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tx power at 0m: " />

                <TextView
                    android:id="@+id/tv_eddystone_uid_rssi"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID Namespace: " />

                <TextView
                    android:id="@+id/tv_eddystone_namespace"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID Instance: " />

                <TextView
                    android:id="@+id/tv_eddystone_intance"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reserved: " />

                <TextView
                    android:id="@+id/tv_eddystone_reserved"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_eddystone_tlm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version: " />

                <TextView
                    android:id="@+id/tv_eddystone_tlm_version"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery voltage: " />

                <TextView
                    android:id="@+id/tv_eddystone_tlm_battery_voltage"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_eddystone_tlm_temperature"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Advertisements count: " />

                <TextView
                    android:id="@+id/tv_eddystone_tlm_advertisements_count"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time since power-up: " />

                <TextView
                    android:id="@+id/tv_eddystone_tlm_time_since_power_up"
                    style="@style/BeaconInfo_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="unknow" />

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

</merge>