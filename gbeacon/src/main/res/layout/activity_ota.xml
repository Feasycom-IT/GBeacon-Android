<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/header" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/select_file_constraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp">

        <ImageButton
            android:id="@+id/select_file_image"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/file"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/select_file_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/select_file_image"
            android:layout_toEndOf="@id/select_file_image"
            android:text="@string/openFile"
            app:layout_constraintBottom_toBottomOf="@+id/select_file_image"
            app:layout_constraintStart_toEndOf="@+id/select_file_image"
            app:layout_constraintTop_toTopOf="@+id/select_file_image" />

        <ImageButton
            android:id="@+id/download_file_img"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@+id/select_file_tv"
            android:background="@drawable/download"
            app:layout_constraintBottom_toBottomOf="@+id/select_file_tv"
            app:layout_constraintStart_toEndOf="@+id/select_file_tv"
            app:layout_constraintTop_toTopOf="@+id/select_file_tv" />

        <TextView
            android:id="@+id/download_file_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/download_file_img"
            android:layout_toEndOf="@id/download_file_img"
            android:text="@string/downloadFile"
            app:layout_constraintBottom_toBottomOf="@+id/download_file_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/download_file_img"
            app:layout_constraintTop_toTopOf="@+id/download_file_img" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/file_linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp">

        <TextView
            style="@style/otaText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/otaFile" />

        <TextView
            android:id="@+id/otaFileName"
            style="@style/otaText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/OTAInfoLL"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/module" />

            <TextView
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/firmware_version" />

            <TextView
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/blVersion" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/current" />

            <TextView
                android:id="@+id/currentModule"
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="-" />

            <TextView
                android:id="@+id/currentVersion"
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="-" />

            <TextView
                android:id="@+id/currentBLVersion"
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="-" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/except" />

            <TextView
                android:id="@+id/exceptModule"
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="-" />

            <TextView
                android:id="@+id/exceptVersion"
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="-" />

            <TextView
                android:id="@+id/exceptBLVersion"
                style="@style/otaText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="-" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/resetLL"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:ignore="NestedWeights" />

        <TextView
            style="@style/otaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/rest" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/otaProgressLL"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:visibility="gone">

        <com.glowbird.gbeacon.ui.view.CircleNumberProgress
            android:id="@+id/otaProgress"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:visibility="visible" />
    </LinearLayout>

    <Button
        android:id="@+id/startOTA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="30dp"
        android:background="@drawable/ota_btn_round_background"
        android:enabled="false"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:text="@string/start"
        android:textAllCaps="false" />

</LinearLayout>