<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/header" />

    <!-- ***********************************iBeacon********************************* -->

    <LinearLayout
        android:id="@+id/iBeacon_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/grey"
            android:text="----iBeacon----"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UUID"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/ibeacon_broadcast_uuid"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="8-4-4-4-12"
                android:paddingStart="10dp"
                android:textColorHint="@color/color_CCCCCC"
                android:digits="0123456789abcdefABCDEF-"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Major"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/ibeacon_broadcast_major"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="0 ~ 65535"
                android:paddingStart="10dp"
                android:textColorHint="@color/color_CCCCCC"
                android:inputType="number"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minor"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/ibeacon_broadcast_minor"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="0 ~ 65535"
                android:paddingStart="10dp"
                android:textColorHint="@color/color_CCCCCC"
                android:inputType="number"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSSI at 1m"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/ibeacon_broadcast_rssi"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="-100 ~ 0"
                android:textColorHint="@color/color_CCCCCC"
                android:paddingStart="10dp"
                android:background="@drawable/custom_broadcast_bg"
                android:digits="0123456789-"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <com.glowbird.gbeacon.ui.view.SwitchButton
            android:id="@+id/ibeacon_broadcast_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- ***********************************AOABeacon********************************* -->

    <LinearLayout
        android:id="@+id/aoaBeacon_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="visible"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/grey"
            android:text="----AoA Beacon----"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The last four digits of Mac"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/aoaBeacon_broadcast_mac"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Default is 0000"
                android:paddingStart="10dp"
                android:textColorHint="@color/color_CCCCCC"
                android:inputType="number"
                android:maxLength="4"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alarm"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <com.glowbird.gbeacon.ui.view.SwitchButton
                    android:id="@+id/aoaBeacon_alarm_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moving"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <com.glowbird.gbeacon.ui.view.SwitchButton
                    android:id="@+id/aoaBeacon_moving_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/channel" />

                <RadioGroup
                    android:id="@+id/radioGroupChannel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RadioButton
                        android:id="@+id/Channel37"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/_37" />

                    <RadioButton
                        android:id="@+id/Channel38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/_38" />

                    <RadioButton
                        android:id="@+id/Channel39"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/_39" />
                </RadioGroup>
            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode" />

                <RadioGroup
                    android:id="@+id/radioGroupMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/MODE_LOW_POWER"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/mode_low_power" />

                    <RadioButton
                        android:id="@+id/MODE_BALANCED"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/mode_balanced" />

                    <RadioButton
                        android:id="@+id/MODE_LOW_LATENCY"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/mode_low_latency" />
                </RadioGroup>
            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelTxPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tx_power" />

                <RadioGroup
                    android:id="@+id/radioGroupTxPower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/TX_POWER_ULTRA_LOW"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/tx_power_ultra_low" />

                    <RadioButton
                        android:id="@+id/TX_POWER_LOW"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/tx_power_low" />

                    <RadioButton
                        android:id="@+id/TX_POWER_MEDIUM"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/tx_power_medium" />

                    <RadioButton
                        android:id="@+id/TX_POWER_HIGH"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/tx_power_high" />
                </RadioGroup>
            </LinearLayout>

        </LinearLayout>

        <com.glowbird.gbeacon.ui.view.SwitchButton
            android:id="@+id/aoaBeacon_broadcast_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- ***********************************altBeacon********************************* -->

    <LinearLayout
        android:id="@+id/altBeacon_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/grey"
            android:text="----altBeacon----"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID1:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/altBeacon_broadcast_id1"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/altbeacon_id1"
                android:paddingStart="10dp"
                android:textColorHint="@color/color_CCCCCC"
                android:maxLength="32"
                android:digits="0123456789abcdefABCDEF"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID2:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/altBeacon_broadcast_id2"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/altbeacon_id2"
                android:paddingStart="10dp"
                android:digits="0123456789abcdefABCDEF"
                android:textColorHint="@color/color_CCCCCC"
                android:maxLength="4"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID3:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/altBeacon_broadcast_id3"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/altbeacon_id2"
                android:paddingStart="10dp"
                android:digits="0123456789abcdefABCDEF"
                android:textColorHint="@color/color_CCCCCC"
                android:maxLength="4"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSSI at 1m:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/altBeacon_broadcast_rssi"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="-128 ~ 127"
                android:textColorHint="@color/color_CCCCCC"
                android:paddingStart="10dp"
                android:background="@drawable/custom_broadcast_bg"
                android:digits="0123456789-"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manufacturer ID"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/altBeacon_broadcast_manufacturer_id"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/altbeacon_manufacturer_id"
                android:textColorHint="@color/color_CCCCCC"
                android:paddingStart="10dp"
                android:background="@drawable/custom_broadcast_bg"
                android:inputType="number"
                android:maxLength="5"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manufacturer Reserved"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/altBeacon_broadcast_manufacturer_reserved"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/altbeacon_manufacturer_reserved"
                android:textColorHint="@color/color_CCCCCC"
                android:paddingStart="10dp"
                android:background="@drawable/custom_broadcast_bg"
                android:digits="0123456789abcdefABCDEF"
                android:maxLength="2"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <com.glowbird.gbeacon.ui.view.SwitchButton
            android:id="@+id/altBeacon_broadcast_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- ***********************************Eddystone-UID********************************* -->

    <LinearLayout
        android:id="@+id/eddyUid_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/grey"
            android:text="----Eddystone-UID----"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Namespace:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/eddyUid_broadcast_namespace"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/eddyUid_namespace"
                android:paddingStart="10dp"
                android:textColorHint="@color/color_CCCCCC"
                android:maxLength="20"
                android:digits="0123456789abcdefABCDEF"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instance:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/eddyUid_broadcast_instance"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/eddyUid_instance"
                android:paddingStart="10dp"
                android:digits="0123456789abcdefABCDEF"
                android:textColorHint="@color/color_CCCCCC"
                android:maxLength="12"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reserved:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/eddyUid_broadcast_reserved"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/altbeacon_id2"
                android:paddingStart="10dp"
                android:digits="0123456789abcdefABCDEF"
                android:textColorHint="@color/color_CCCCCC"
                android:maxLength="4"
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSSI at 0m:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/eddyUid_broadcast_rssi"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="-128 ~ 127"
                android:textColorHint="@color/color_CCCCCC"
                android:paddingStart="10dp"
                android:background="@drawable/custom_broadcast_bg"
                android:digits="0123456789-"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <com.glowbird.gbeacon.ui.view.SwitchButton
            android:id="@+id/eddyUid_broadcast_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- ***********************************Eddystone-URL********************************* -->

    <LinearLayout
        android:id="@+id/eddyUrl_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/grey"
            android:text="----Eddystone-URL----"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL:"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/eddyUrl_broadcast_url"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="https://www.glowbird.com"
                android:paddingStart="10dp"
                android:textColorHint="@color/color_CCCCCC"
                android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ:/."
                android:background="@drawable/custom_broadcast_bg"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSSI at 0m:"
                android:textColor="@color/black"
                android:textSize="18sp" />

