<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#d7d7d7"
    tools:viewBindingIgnore="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="45dp" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">


        <TextView
            android:id="@+id/header_left"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="5dp"
            android:gravity="start|center_vertical"
            android:textColor="@color/midBlue"
            android:textSize="14sp"
            android:paddingStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintStart_toStartOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title" />

        <TextView
            android:id="@+id/custom_broadcast_tv"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:gravity="start|center_vertical"
            android:textColor="@color/midBlue"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@+id/header_left"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title" />

        <ImageView
            android:id="@+id/qrcode_scan_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:src="@drawable/qrcode_scan"
            android:gravity="start|center_vertical"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@+id/header_left"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/setting_name"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/header_set_key"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:textColor="@color/midBlue"
            android:textSize="14sp"
            android:paddingEnd="10dp"
            android:gravity="right|center_vertical"
            app:layout_constraintEnd_toStartOf="@+id/header_right"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/header_right"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:gravity="right|center_vertical"
            android:textColor="@color/midBlue"
            android:textSize="14sp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/spinner_beacon_type"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:gravity="right|center_vertical"
            android:textColor="@color/midBlue"
            android:textSize="14sp"
            android:paddingEnd="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>



</LinearLayout>
